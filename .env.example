POSTGRES_DB=tdnet
POSTGRES_USER=tdnet
POSTGRES_PASSWORD=tdnet
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://tdnet:tdnet@localhost:55432/tdnet
TDNET_DOWNLOAD_ROOT=/Volumes/yakushimachi/Downloads
TDNET_API_TITLE=TDnet API
TDNET_API_VERSION=0.1.0

# PARKED (2026-10-25): the legacy tdnet-postgres database that DATABASE_URL
# above points at is retired. The `tdnet` CLI's scrape(--persist)/list/
# download/parse/ocr/parse-ixbrl/persist-parse-text/tag-reports/
# analyze-financials/list-tags/pipeline-run commands, `scripts/
# tdnet_all_in_one.sh --legacy-local`, and the app/backend review workbench
# all refuse to run against it (see tdnet/database.py). TDnet disclosure
# history now lives in the research database's raw_tdnet_history; document
# download/parse will move there under Root issue #50. Set this to
# deliberately re-enable the parked Python-side code (the shell script's own
# refusal needs its early-exit block removed by hand -- it does not read
# this variable):
# TDNET_LEGACY_LOCAL_ENABLED=1

# tdnet/api.py and `tdnet review-parse` read the research DB's migrated
# TDnet history views (analysis.tdnet_*_history_v1) as research_reader, not
# DATABASE_URL above. Leave unset to build the URL in memory from Root's
# session file (.research-runtime/session.json); set it only to point at a
# different research_reader endpoint (e.g. a local test database).
# RESEARCH_DATABASE_URL=postgresql+asyncpg://research_reader:...@127.0.0.1:54790/hft_research
